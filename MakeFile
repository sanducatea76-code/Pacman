	CXX = g++
	CXXFLAGS = -std=c++17 -Wall -Wextra
	TARGET = Pacman.exe
	SRCS = Main.cpp Engine.cpp Listener.cpp Renderer.cpp Position.cpp Pacman.cpp Ghost.cpp
	OBJS = $(SRCS:.cpp=.o)
	all: $(TARGET)
	$(TARGET): $(OBJS)
	$(CXX) $(CXXFLAGS) -o $(TARGET) $(OBJS)
	%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@
	clean:
	rm -f *.o *.exe
	.PHONY: all clean